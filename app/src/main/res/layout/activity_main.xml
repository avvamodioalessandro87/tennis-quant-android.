<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:text="Tennis Quant" android:textSize="30sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/status" android:text="Motore Tennis Quant" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/playerA" android:hint="Player ID A" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/playerB" android:hint="Player ID B" android:layout_width="match_parent" android:layout_height="wrap_content"/><Spinner android:id="@+id/surface" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/analyze" android:text="Analizza match" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/result" android:textSize="18sp" android:paddingTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/oddsA" android:hint="Quota bookmaker A" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/oddsB" android:hint="Quota bookmaker B" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/market" android:text="Valuta mercato" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/marketResult" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout></ScrollView>
